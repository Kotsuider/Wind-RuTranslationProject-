{
  "injector": {
    "enable": true,
    "target_module": "WindRP_ru.exe",
    "print_loaded_modules": true
  },
  
    "allocate_console": false,

    "character_substitution": {
      "enable": true,
      "source_characters": "><+%#^@;/",
      "target_characters": "ÓÕ¹²É«»{}"
    },

    "font_manager": {
      "enable": true,
      "resource_files": [
        "OUCTSfontD1.ttf"
      ],
      "spoof_enumeration": {
        "enable": true,
        "filter_pitch_and_family": 1,
        "filter_charset": 1,
        "spoof_charset": 128
      },
      "spoof_creation": {
        "enable": true,
        "override_face": "OUCTSfontD1",
        "override_charset": 0
      }
    },

    "window_manager": {
    "enable": true,
    "overwrite_title": "Ветер: Дыхание сердца",
    "process_existing_windows": true
  }
}